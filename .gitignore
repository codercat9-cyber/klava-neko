# Личное: история разговоров, журналы, голоса друзей, настройки с именами и выбранными мозгами
/data/
/klava.json
/klava.json.*
/workspace/
/web/config.backups/
# свой облик: её вещи из мастерской, сшитые наряды, правки редактора (в репозитории — web/config.default.json)
/web/config.json
/web/config.default.last.json
/web/models/

# Мост Minecraft ставится через npm install; у аватара node_modules ЛЕЖИТ в репозитории (three.js, three-vrm),
# чтобы он шёл без Node
/mineflayer_bridge/node_modules/

# Кандидаты голоса, кроме эталона Клавы (tts/voice.json → klava_02.wav)
/tts/voices/rejected/
/tts/voices/old_mia/
/tts/voices/candidates/klava_0[13-9].wav

# Инструменты только для машины автора и батники публикации
