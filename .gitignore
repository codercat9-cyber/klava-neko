# Модели и среды — их качают скрипты tools\*.ps1 (УСТАНОВИТЬ.bat)
/models/
/runtime/
/tts/.venv/
__pycache__/

# Сборки
/bin/
/bin_*/
/app/*/bin/
/editor_bin/
/pult_bin/
obj/
